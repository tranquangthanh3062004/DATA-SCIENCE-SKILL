# ╔══════════════════════════════════════════════════════════════════════════╗
# ║  ADI-OS — Environment Configuration Template                           ║
# ║  Copy this file to .env and fill in the values                         ║
# ║  NEVER commit .env to version control                                  ║
# ╚══════════════════════════════════════════════════════════════════════════╝

# ── General ──
ENVIRONMENT=development              # development | staging | production
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
PROJECT_NAME=adi-os

# ── Data Warehouse ──
DWH_HOST=localhost
DWH_PORT=5432
DWH_DATABASE=adi_os
DWH_SCHEMA=public
DWH_USER=your_username
DWH_PASSWORD=your_password

# ── Data Lake / Object Storage ──
DATA_LAKE_PROVIDER=local              # local | s3 | gcs | adls
DATA_LAKE_BUCKET=adi-os-datalake
DATA_LAKE_PATH=./data

# AWS (if using S3)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=ap-southeast-1

# GCP (if using GCS)
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
GCP_PROJECT_ID=your_gcp_project

# ── MLflow / Experiment Tracking ──
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=adi-os-default
MLFLOW_ARTIFACT_ROOT=./mlruns

# ── Model Serving ──
MODEL_SERVING_HOST=0.0.0.0
MODEL_SERVING_PORT=8000

# ── Data Quality ──
GX_DATA_CONTEXT_ROOT=./contracts/great_expectations
SODA_CONFIG_PATH=./contracts/soda

# ── Monitoring & Alerting ──
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
PAGERDUTY_API_KEY=your_pagerduty_key

# ── Security ──
ENCRYPTION_KEY=your_encryption_key_base64
PII_DETECTION_ENABLED=true
AUDIT_LOG_PATH=./logs/audit
