FROM python:3.11-slim

WORKDIR /workspace

RUN pip install --no-cache-dir \
    jupyterlab>=4.0 \
    ipykernel \
    duckdb \
    pandas \
    polars \
    pyarrow \
    plotly \
    matplotlib \
    seaborn \
    sqlalchemy \
    psycopg2-binary

EXPOSE 8888

CMD ["sh", "-c", "exec jupyter lab --ip=0.0.0.0 --port=8888 --no-browser --allow-root --IdentityProvider.token=\"${JUPYTER_TOKEN:?JUPYTER_TOKEN must be set}\""]
